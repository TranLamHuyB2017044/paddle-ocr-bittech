{
  "pythonVersion": "3.11",
  "venvPath": ".",
  "venv": "venv",
  "include": ["src", "."],
  "extraPaths": [
    "src",
    "src/core",
    "src/shared",
    "src/modules"
  ],
  "ignore": [
    "**/__pycache__",
    "venv",
    "**/__pyrefly_virtual__/**"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "venv",
    "**/__pyrefly_virtual__/**"
  ],
  "typeCheckingMode": "basic",
  "reportMissingImports": "none",
  "reportMissingModuleSource": "none"
}
